# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# .env is git-ignored and loaded automatically from the repository root by
# rag_pipeline/config.py. Every variable read by config.py is listed below.
#
# OPENAI_API_KEY is OPTIONAL. When it is empty the report generator falls back
# to the offline template report instead of calling the LLM.

# API key for the OpenAI-compatible router/LLM provider
OPENAI_API_KEY=

# Base URL of the OpenAI-compatible endpoint
OPENAI_BASE_URL=https://api.openai.com/v1

# Chat model used to generate the clinical report
LLM_MODEL=gemini-2.0-flash

# Embedding model used to build / query the FAISS vector index
EMBEDDING_MODEL=text-embedding-3-small

# ---- RAG knobs ----
# Relative paths are resolved against the repository root.
KNOWLEDGE_DIR=knowledge
FAISS_INDEX_PATH=rag_pipeline/faiss_index
CHUNK_SIZE=800
CHUNK_OVERLAP=100
TOP_K=5
RAG_MIN_SCORE=0.1

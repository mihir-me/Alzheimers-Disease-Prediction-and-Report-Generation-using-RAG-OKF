# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# .env is git-ignored and loaded automatically from the repository root by
# rag_pipeline/config.py. Every variable read by config.py is listed below.
#
# OPENAI_API_KEY is OPTIONAL. When it is empty the report generator falls back
# to the offline template report instead of calling the LLM.

# API key for the OpenAI-compatible router/LLM provider
OPENAI_API_KEY=

# Base URL of the OpenAI-compatible endpoint
OPENAI_BASE_URL=https://api.openai.com/v1

# Chat model used to generate the clinical report
LLM_MODEL=gemini-2.0-flash

# Embedding model used to build / query the FAISS vector index
EMBEDDING_MODEL=text-embedding-3-small

# ---- RAG knobs ----
# Relative paths are resolved against the repository root.
KNOWLEDGE_DIR=knowledge

# OKF markdown bundle used by the concept-aware retrieval ("okf_rag"/"okf_only").
OKF_BUNDLE_DIR=knowledge/okf_bundle

FAISS_INDEX_PATH=rag_pipeline/faiss_index
CHUNK_SIZE=800
CHUNK_OVERLAP=100
TOP_K=5
RAG_MIN_SCORE=0.1

# Retrieval strategy:
#   okf_rag  (default) vector search over OKF concepts + one-hop link expansion
#   rag_only           vector search only, no link expansion
#   okf_only           no vectors: match concepts from the prediction payload
#                      (CDR / MMSE / nWBV / stage tags, types and keywords),
#                      then expand one hop along the OKF links
RAG_MODE=okf_rag

# Maximum number of concepts (direct hits + link-expanded) given to the report
RAG_MAX_CONCEPTS=6
